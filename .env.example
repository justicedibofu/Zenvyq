# ZENVYQ Environment Variables Configuration
# Copy this file to .env.local (for local dev) or .env.production / .env (for Interserver / VPS hosting)

# Public contact details (used across the landing page)
# Format WhatsApp number with international country code without '+' or special characters, e.g. 2348012345678
# NOTE: If NEXT_PUBLIC_WHATSAPP_NUMBER is left empty, WhatsApp CTA buttons will automatically hide gracefully.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
NEXT_PUBLIC_CONTACT_EMAIL=contact@zenvyq.tech

# Server-side Contact Form Email Sending (Optional / Resend)
RESEND_API_KEY=
CONTACT_EMAIL=contact@zenvyq.tech
